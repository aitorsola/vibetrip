# --- Supabase (required) ---
# Project URL and keys from supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LLM provider (required) ---
# One of: anthropic | openai-compatible
# If unset: auto-detected (anthropic when ANTHROPIC_API_KEY is present,
# else openai-compatible when OPENAI_BASE_URL is).
LLM_PROVIDER=openai-compatible

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI-compatible (Groq, Together, DeepInfra, LM Studio, Ollama…) ---
# Groq:               https://api.groq.com/openai/v1
# LM Studio (local):  http://localhost:1234/v1
# The model MUST support tool calling — the itinerary and accommodation
# agents are useless without it.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Booking affiliate (optional) ---
# Public ID — also exposed to the client via NEXT_PUBLIC_ for the result page.
BOOKING_AFFILIATE_ID=YOUR_AFFILIATE_ID
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=YOUR_AFFILIATE_ID

# --- Per-agent max_tokens (optional, defaults in src/server/env.ts) ---
# The agent loop resends the whole conversation each turn, so prompt +
# max_tokens has to fit under the provider's per-minute token budget.
# On Groq's free tier (12k TPM for llama-3.3-70b) keep the itinerary at 5000;
# above that a long run dies with a 413 partway through.
ITINERARY_MAX_TOKENS=5000
ACCOMMODATION_MAX_TOKENS=2000
